// ============================================================
// prisma/models/user.prisma
// Core identity models: Business, User, TraderProfile.
// ============================================================

/// An organisation that owns one or more trader accounts.
/// Supports future multi-trader / franchise expansion.
model Business {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Traders who belong to this business
  traders TraderProfile[]

  @@map("business")
}

/// Core user account. One row per unique authenticated identity.
/// Configured for Better Auth integration.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?   @unique
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Present when role == TRADER
  traderProfile TraderProfile?

  sessions Session[]
  accounts Account[]

  @@index([email])
  @@index([phone])
  @@map("user")
}

/// Extended profile for traders.
/// Linked 1-to-1 with User and optionally to a Business.
model TraderProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  businessId      String?
  /// Stripe Connect Express/Standard account ID for marketplace payouts
  stripeAccountId String?   @unique
  displayName     String
  bio             String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  /// Bookings where this trader is the assigned professional
  bookings       Booking[]
  /// Daily work areas declared by this trader
  dailyWorkAreas DailyWorkArea[]

  @@index([businessId])
  @@map("trader_profile")
}
